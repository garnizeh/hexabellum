# ==========================================
# Rust / Cargo
# ==========================================
# Generated by Cargo when compiling
/target/

# Cargo.lock is usually kept for binary apps, but ignored for libraries.
# Remove the hash (#) below if this project is purely a library.
# Cargo.lock

# Backup files generated by cargo login
**/*.rs.bk

# Micro-architectural copies for core dump analysis
core

# ==========================================
# Vite / Node / Frontend
# ==========================================
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependency directories
node_modules/
jspm_packages/

# VQL / Vite cache
.vite/
.nuxt/
.next/

# Production build outputs
dist/
dist-ssr/
out/
build/

# IDEs and Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.*.local
*.env
*.env.*

